      "current": {
        "code": "\nfrom binaryninja import BinaryView, TypeClass\nfrom Vector35_Sidekick.code_analysis.data_scanning import scan_data_for_function_pointers\n\n\ndef add_if_adddress_taken(container, role, operand, parent, addr):\n    if role == \"dest\" or parent is None:\n        return\n    if operand.value.value == addr:\n        container.add(addr)\n\n\ndef indexer(bv: BinaryView):\n    scan_data_for_function_pointers(bv)\n\n    starts = set()\n    for var in bv.data_vars.values():\n        if var.type.type_class == TypeClass.PointerTypeClass:\n            func = bv.get_function_at(var.value)\n            if func and func.start not in starts:\n                starts.add(func.start)\n                yield func\n    for func in bv.functions:\n        for ref in bv.get_code_refs(func.start):\n            if ref.mlil is None:\n                continue\n            starts_in_ref = set()\n            ref.mlil.visit(lambda r, v, __, p: add_if_adddress_taken(starts_in_ref, r, v, p, func.start))\n            if starts_in_ref and func.start not in starts:\n                starts.add(func.start)\n                yield func\n\n\nwith open_index(bv, 'Indirect Call Targets') as index:\n    entries = list(indexer(bv))\n    for i, entry in enumerate(entries):\n        notify_progress(i, len(entries), 'Running Indirect Call Targets...')\n        metadata = None\n        if isinstance(entry, tuple):\n            entry, metadata = entry\n        index.add_entry(entry, metadata)\n",
