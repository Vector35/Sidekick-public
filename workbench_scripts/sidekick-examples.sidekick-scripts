        "code": "\nfrom binaryninja import BinaryView, MediumLevelILOperation\n\n\ndef get_allocator_addresses(bv):\n    allocators = [\n        'operator new',\n        'operator new[]',\n        'malloc',\n        'calloc',\n        'realloc',\n        'alloca',\n        'alloca_with_align',\n        'valloc',\n        'pvalloc',\n        'memalign',\n        'posix_memalign',\n        'aligned_alloc',\n        'HeapAlloc',\n        'LocalAlloc',\n        'GlobalAlloc',\n        'VirtualAlloc',\n        'VirtualAllocEx',\n        'VirtualAllocExNuma',\n    ]\n    symbols = []\n    for name in allocators:\n        for sym in bv.get_symbols_by_name(name):\n            symbols.append(sym)\n    addrs = set([sym.address for sym in symbols])\n    print([hex(a) for a in addrs])\n    return addrs\n\n\ndef indexer(bv: BinaryView):\n    alloc_addrs = get_allocator_addresses(bv)\n    for insn in bv.mlil_instructions:\n        if insn.operation == MediumLevelILOperation.MLIL_CALL:\n            if insn.dest.operation == MediumLevelILOperation.MLIL_CONST_PTR:\n                if insn.dest.constant in alloc_addrs:\n                    # Check if at least one argument is not a constant\n                    if any([arg.operation != MediumLevelILOperation.MLIL_CONST for arg in insn.params]):\n                        yield insn\n\n\nwith open_index(bv, 'Dynamic Allocations') as index:\n    entries = list(indexer(bv))\n    for i, entry in enumerate(entries):\n        notify_progress(i, len(entries), 'Running Dynamic Allocations...')\n        metadata = None\n        if isinstance(entry, tuple):\n            entry, metadata = entry\n        index.add_entry(entry, metadata)\n",
