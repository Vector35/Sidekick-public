        "code": "\nfrom binaryninja import BinaryView, VariableSourceType\nfrom Vector35_Sidekick.indexing import IndexedValue\nfrom typing import Generator\n\n\ndef indexer(bv: BinaryView) -> Generator[IndexedValue, None, None]:\n    for hlil_func in bv.hlil_functions():\n        for var in hlil_func.aliased_vars:\n            if var.source_type == VariableSourceType.StackVariableSourceType:\n                yield (hlil_func.source_function.start, var)\n\n\nwith open_index(bv, 'Stack Buffers') as index:\n    entries = list(indexer(bv))\n    for i, entry in enumerate(entries):\n        notify_progress(i, len(entries), 'Running Stack Buffers...')\n        metadata = None\n        if isinstance(entry, tuple):\n            entry, metadata = entry\n        index.add_entry(entry, metadata)\n",
