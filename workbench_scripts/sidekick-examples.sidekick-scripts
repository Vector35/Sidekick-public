        "uuid": "44e9a930-b8b9-453c-a4d1-1496678407d0",
        "title": "Utility Functions",
        "last_modified": "2024-08-09T08:14:51.391165",
        "last_executed": null
      },
      "current": {
        "code": "\nfrom binaryninja import BinaryView\nfrom scipy.optimize import curve_fit\nimport numpy as np\n\n\n# Define power-law function\ndef power_law(k, alpha, C):\n    return C * k ** (-alpha)\n\n\ndef indexer(bv: BinaryView):\n    bv.update_analysis_and_wait()\n\n    # Compute out-degrees for each function\n    functions = list(bv.functions)\n    in_degrees = [len(set(func.callers)) for func in functions]\n    unique_degrees, counts = np.unique(in_degrees, return_counts=True)\n\n    # Normalize the counts to get probabilities\n    probs_extended = counts / counts.sum()\n\n    # Remove data points with an out-degree of 0 (to avoid division by zero in the power-law function)\n    non_zero_degrees = unique_degrees[unique_degrees != 0]\n    non_zero_probs = probs_extended[unique_degrees != 0]\n\n    # Fit the power-law model\n    params, _ = curve_fit(power_law, non_zero_degrees, non_zero_probs)\n\n    # Find outliers based on P(k) and threshold\n    threshold = 0.001  # Threshold for filtering outliers\n    for func, in_degree in zip(functions, in_degrees):\n        if in_degree != 0 and power_law(in_degree, *params) < threshold:\n            yield func, {\"In-Degree\": in_degree}\n\n\nwith open_index(bv, 'Utility Functions') as index:\n    entries = list(indexer(bv))\n    for i, entry in enumerate(entries):\n        notify_progress(i, len(entries), 'Running Utility Functions...')\n        metadata = None\n        if isinstance(entry, tuple):\n            entry, metadata = entry\n        index.add_entry(entry, metadata)\n",
        "llm_op_specifications": []
      }
