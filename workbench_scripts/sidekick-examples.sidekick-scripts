      "current": {
        "code": "# This script iterates through each call instruction in the binary and classifies\n# the symbol name of the callee function\nfrom binaryninja import BinaryView, MediumLevelILOperation\nfrom Vector35_Sidekick.api.symbols import classify_symbols, InspectionCategory\n\nwith open_index(bv, 'Classify Calls') as index:\n    sym_cat_mapping = {sym.address: cat for sym, cat in classify_symbols(bv)}\n    addresses = set(sym_cat_mapping.keys())\n\n    call_insns = [insn for insn in bv.mlil_instructions if insn.operation == MediumLevelILOperation.MLIL_CALL and insn.dest.operation == MediumLevelILOperation.MLIL_CONST_PTR]\n    for i, insn in enumerate(call_insns):\n        notify_progress(i, len(call_insns), \"Classifying calls...\")\n        if insn.dest.constant in addresses:\n            category = sym_cat_mapping[insn.dest.constant]\n            index.add_entry(insn, {\"Category\": category.name})\n",
