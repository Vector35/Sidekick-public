        "code": "\nfrom binaryninja import BinaryView, SymbolType\n\n\ndef indexer(bv: BinaryView):\n    def is_address_taken(addr: int):\n        try:\n            next(bv.get_code_refs(addr))\n            return True\n        except StopIteration:\n            pass\n        try:\n            next(bv.get_data_refs(addr))\n            return True\n        except StopIteration:\n            pass\n        return False\n\n    for func in bv.functions:\n        # Functions defined in this binary\n        if func.symbol.type == SymbolType.FunctionSymbol:\n            # Functions with zero in-degree\n            if len(func.callers) == 0:\n                # Functions whose address is not taken\n                if not is_address_taken(func.start):\n                    yield func\n\n\nwith open_index(bv, 'Entry Points') as index:\n    entries = list(indexer(bv))\n    for i, entry in enumerate(entries):\n        notify_progress(i, len(entries), 'Running Entry Points...')\n        metadata = None\n        if isinstance(entry, tuple):\n            entry, metadata = entry\n        index.add_entry(entry, metadata)\n",
